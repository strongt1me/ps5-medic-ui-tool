{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PS5 Medic rules database",
  "type": "object",
  "required": ["schema_version", "db_version", "rules"],
  "properties": {
    "schema_version": { "const": 1 },
    "db_version": { "type": "string" },
    "requires_level": { "type": "integer", "minimum": 1, "description": "Formatstufe, die die App mindestens kennen muss (kRuleFormatLevel in rules.hpp); fehlt die Angabe, gilt 1. Hoehere Stufen lehnt eine aeltere App als zu neu ab." },
    "metrics": {
      "type": "array",
      "description": "Messwerte, die der Verlauf der Check-ups mitschreibt (Veraenderung seit der letzten Pruefung, uebliches Niveau).",
      "items": {
        "type": "object",
        "required": ["id", "fact", "text"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_.]+$" },
          "fact": { "type": "string", "description": "einfacher Faktpfad ohne []" },
          "unit": { "type": "string" },
          "text": { "type": "object", "required": ["de", "en"], "properties": { "de": { "type": "string" }, "en": { "type": "string" } } }
        }
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "tested_when"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_.]+$" },
          "text": { "type": "object", "required": ["de", "en"], "properties": { "de": { "type": "string" }, "en": { "type": "string" } } },
          "tested_when": { "$ref": "#/$defs/condition" }
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "when", "text", "source", "verified"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_.]+$" },
          "severity": { "enum": ["critical", "warning", "info"] },
          "when": { "$ref": "#/$defs/condition" },
          "text": {
            "type": "object",
            "required": ["de", "en"],
            "properties": { "de": { "type": "string" }, "en": { "type": "string" } }
          },
          "evidence": { "type": "string" },
          "evidence_filter": { "type": "string", "description": "Regex: nur passende Array-Elemente als Evidenz (z. B. Log-Zeilen)" },
          "fix": { "type": ["string", "null"] },
          "fix_params": { "type": "object", "description": "Parameter fuer den Fix, siehe libmedic/include/medic/fixes.hpp" },
          "source": { "type": "string", "format": "uri" },
          "verified": { "enum": ["doc", "community", "todo"] },
          "confidence": {
            "type": "object",
            "description": "Wie sicher der Befund ist und warum. Ohne Angabe gilt der Standard aus verified (doc: high/doc, community: medium/community, todo: low/unknown). Eine Angabe braucht reason. Ohne Beleg (todo) nie high; high nur mit basis doc oder observed; basis nicht staerker als verified.",
            "required": ["reason"],
            "additionalProperties": false,
            "properties": {
              "level": { "enum": ["high", "medium", "low"] },
              "basis": { "enum": ["observed", "doc", "community", "derived", "unknown"], "description": "observed: an der Konsole gelesen oder gemessen; doc: dokumentiert; community: Bericht; derived: abgeleitet; unknown: nicht bestaetigt" },
              "reason": {
                "type": "object",
                "required": ["de", "en"],
                "properties": { "de": { "type": "string", "minLength": 1 }, "en": { "type": "string", "minLength": 1 } }
              }
            }
          },
          "confirm_runs": { "type": "integer", "minimum": 1, "maximum": 10, "description": "Pruefungen in Folge, bis der Befund als bestaetigt gilt (Standard 1); davor wird er als vorlaeufig gezeigt" },
          "applies_fw": { "type": "string", "pattern": "^\\s*((<=|>=|<|>|=)?\\s*[0-9]+(\\.[0-9]+)*[A-Za-z]*[0-9]*\\s*)+$", "description": "Versionsbereich, z. B. \">=7.00 <=13.60\": Teile mit Leerraum getrennt, je Operator (< <= > >= =, optional) und Version; der Lader lehnt Tippfehler ab" }
        }
      }
    }
  },
  "$defs": {
    "condition": {
      "oneOf": [
        { "type": "object", "required": ["all"], "properties": { "all": { "type": "array", "items": { "$ref": "#/$defs/condition" } } } },
        { "type": "object", "required": ["any"], "properties": { "any": { "type": "array", "items": { "$ref": "#/$defs/condition" } } } },
        { "type": "object", "required": ["not"], "properties": { "not": { "$ref": "#/$defs/condition" } } },
        {
          "type": "object",
          "required": ["fact"],
          "properties": {
            "fact": { "type": "string" },
            "eq": {}, "in": { "type": "array" },
            "lt": { "type": "string" }, "gt": { "type": "string" },
            "matches": { "type": "string" },
            "contains": { "type": "string" },
            "exists": { "type": "boolean" },
            "count_matches": {
              "type": "object",
              "required": ["regex", "gte"],
              "properties": { "regex": { "type": "string" }, "gte": { "type": "integer", "minimum": 1 } },
              "description": "Zaehlt Array-Elemente, die auf regex passen (fact ohne []); wahr ab gte Treffern."
            },
            "default": {}
          }
        }
      ]
    }
  }
}
